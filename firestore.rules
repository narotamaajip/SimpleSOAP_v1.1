rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Doctors can only read/write their OWN profile document
    match /doctors/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Dedicated collection for share codes (resolves cross-doctor redeem permission)
    // Only allow direct point lookup (getDoc) by exact 6-digit code; block collection enumeration (list)
    match /shareCodes/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Patients collection
    match /patients/{patientId} {

      // READ: only if the requester's UID is in accessList
      allow read: if request.auth != null
        && request.auth.uid in resource.data.accessList;

      // CREATE: enforce that the creator sets themselves as ownerId
      // and that accessList only contains their own UID
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.accessList.hasOnly([request.auth.uid])
        && request.resource.data.ownerId in request.resource.data.accessList;

      // UPDATE: four valid cases:
      // (A1) Owner (or legacy patient without ownerId) — can update profile, SOAP, shareCode, soft-delete, etc., as long as ownerId is not modified
      // (A2) Collaborator (in accessList) — can edit profile, SOAP, shareCode, but cannot modify ownerId, accessList, or soft-delete fields
      // (B) Share code redeem — user adds only themselves to accessList (defensive get() for legacy docs)
      // (C) Collaborator voluntarily leaving — removes only themselves from accessList
      allow update: if request.auth != null && (
        // Case A1: Owner (or legacy patient without ownerId) editing patient profile, SOAP, shareCode, soft-delete, etc.
        (
          request.auth.uid in resource.data.get('accessList', [])
          && (resource.data.get('ownerId', '') == request.auth.uid || resource.data.get('ownerId', '') == '')
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId'])
        )
        ||
        // Case A2: Collaborator in accessList (can edit profile, SOAP, and shareCode, but cannot modify ownerId, accessList, or soft-delete fields)
        (
          request.auth.uid in resource.data.get('accessList', [])
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'accessList', 'isDeleted', 'deletedAt', 'deletedBy'])
        )
        ||
        // Case B: redeeming a share code — user adds only themselves to accessList
        (
          resource.data.get('shareCode', '') is string
          && resource.data.get('shareCode', '').size() > 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accessList'])
          && request.resource.data.accessList is list
          && resource.data.get('accessList', []) is list
          && request.resource.data.accessList.hasAll(resource.data.get('accessList', []))
          && request.resource.data.accessList.size() == resource.data.get('accessList', []).size() + 1
          && request.auth.uid in request.resource.data.accessList
          && !(request.auth.uid in resource.data.get('accessList', []))
        )
        ||
        // Case C: collaborator voluntarily leaving — removes only themselves from accessList
        (
          request.auth.uid in resource.data.get('accessList', [])
          && request.auth.uid != resource.data.get('ownerId', '')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accessList'])
          && !(request.auth.uid in request.resource.data.accessList)
          && request.resource.data.accessList.size() == resource.data.get('accessList', []).size() - 1
          && resource.data.get('accessList', []).hasAll(request.resource.data.accessList)
        )
      );

      // DELETE:
      // (A) ownerId matches the current user
      // (B) Legacy patient where ownerId was never set — any accessList member can delete
      allow delete: if request.auth != null && (
        resource.data.get('ownerId', '') == request.auth.uid
        || (resource.data.get('ownerId', '') == '' && request.auth.uid in resource.data.accessList)
      );

      // Subcollection for individual SOAP notes (prevents 1MB limit & race conditions)
      match /soapNotes/{noteId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/patients/$(patientId)).data.accessList;
      }
    }
  }
}
