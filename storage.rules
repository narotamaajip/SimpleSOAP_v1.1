rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // SimpleSOAP only uses Cloud Firestore (no file uploads).
    // Lock Cloud Storage completely to prevent unauthorized storage abuse,
    // while removing the 30-day test mode expiration warning.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
